# DGC Finance — set separately on its own Vibehost account.
NODE_ENV=production
APP_URL=https://erp.digicomjsc.com
APP_NAME=DGC Finance
APP_TITLE=DGC Finance
DEFAULT_COMPANY_CODE=DGC
# Supply the confirmed legal name privately before one-time initialization.
DEFAULT_COMPANY_NAME=
DEFAULT_COMPANY_CURRENCY=USD
DEFAULT_COMPANY_TIMEZONE=Africa/Maputo
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/storage
ERP_SEED_ON_START=false
AUTH_BOOTSTRAP_ENABLED=false
# Set DATABASE_URL and SESSION_SECRET privately for DGC only.
# On the UI service, set API_BASE_URL to the newly provisioned DGC API.
# Optional read-only invoice history; mount a verified archive separately, read-only.
# All three values must be set together. Company UUID must match the DGC tenant.
# DGC_INVOICE_ARCHIVE_ROOT=/app/dgc-invoice-archive
# DGC_INVOICE_ARCHIVE_HASH=<verified archiveHash from migration review>
# DGC_INVOICE_ARCHIVE_COMPANY_ID=<DGC company UUID>
