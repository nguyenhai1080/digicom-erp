model Company {
  cashTransfers CashTransfer[]
  cashAccounts CashAccount[]
  cashEntries CashEntry[]
  cashHistory CashHistory[]
  invoices Invoice[]
  outputReconUploads OutputReconUpload[]
  id                String       @id @default(uuid()) @db.Uuid
  companyCode       String       @unique @map("company_code")
  companyName       String       @map("company_name")
  shortName         String?      @map("short_name")
  taxCode           String?      @map("tax_code")
  address           String?
  phone             String?
  email             String?
  website           String?
  defaultCurrency   String       @default("USD") @map("default_currency") @db.VarChar(3)
  reportingCurrency String?      @map("reporting_currency") @db.VarChar(3)
  timezone          String       @default("UTC")
  locale            String       @default("en")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  users                     User[]
  roles                     Role[]
  configurations            Configuration[]
  sequences                 Sequence[]
  attachments               Attachment[]
  documents                 Document[]
  auditLogs                 AuditLog[]
  partners                  Partner[]
  partnerContacts           PartnerContact[]
  partnerBankAccounts       PartnerBankAccount[]
  services                  Service[]
  partnerServices           PartnerService[]
  serviceRelationships      ServiceRelationship[]
  contracts                 Contract[]
  contractParties           ContractParty[]
  contractItems             ContractItem[]
  contractServices          ContractService[]
  contractTerms             ContractTerm[]
  projects                  Project[]
  projectQualifications     ProjectQualification[]
  projectActivities         ProjectActivity[]
  quotations                Quotation[]
  quotationItems            QuotationItem[]
  approvalWorkflows         ApprovalWorkflow[]
  approvalSteps             ApprovalStep[]
  approvalRequests          ApprovalRequest[]
  approvalActions           ApprovalAction[]
  projectContracts          ProjectContract[]
  activationConditions      ContractActivationCondition[]
  billingSchedules          ContractBillingSchedule[]
  paymentSchedules          ContractPaymentSchedule[]
  contractAdjustmentImpacts ContractAdjustmentImpact[]
  reconciliations           Reconciliation[]
  reconciliationItems       ReconciliationItem[]
  commercialTermSnapshots   CommercialTermSnapshot[]
  revenues                  Revenue[]
  invoiceScopes             InvoiceScope[]
  invoiceScopeItems         InvoiceScopeItem[]
  projectMilestones         ProjectMilestone[]
  projectCostBudgets        ProjectCostBudget[]
  projectCostEntries        ProjectCostEntry[]

  @@map("companies")
}

model User {
  approvedInvoicePayments InvoicePayment[] @relation("PaymentApprovedBy")
  invoices Invoice[]
  outputReconUploads OutputReconUpload[]
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  email        String
  username     String?
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id])
  roles    UserRole[]
  sessions AuthSession[]

  uploadedAttachments           Attachment[]                  @relation("AttachmentUploadedBy")
  createdDocuments              Document[]                    @relation("DocumentCreatedBy")
  auditLogs                     AuditLog[]
  ownedPartners                 Partner[]                     @relation("PartnerOwner")
  ownedContracts                Contract[]                    @relation("ContractOwner")
  ownedProjects                 Project[]                     @relation("ProjectOwner")
  projectQualifications         ProjectQualification[]        @relation("ProjectQualificationBy")
  projectActivities             ProjectActivity[]
  quotationSent                 Quotation[]                   @relation("QuotationSentBy")
  quotationCreated              Quotation[]                   @relation("QuotationCreatedBy")
  quotationApproved             Quotation[]                   @relation("QuotationApprovedBy")
  approvalRequestsSubmitted     ApprovalRequest[]             @relation("ApprovalRequestSubmittedBy")
  approvalActions               ApprovalAction[]              @relation("ApprovalActionBy")
  activationConditionsSatisfied ContractActivationCondition[] @relation("ActivationConditionSatisfiedBy")
  billingTriggersVerified       ContractBillingSchedule[]     @relation("BillingTriggerVerifiedBy")
  reconciliationsCreated        Reconciliation[]              @relation("ReconCreatedBy")
  reconciliationsValidated      Reconciliation[]              @relation("ReconValidatedBy")
  reconciliationsApproved       Reconciliation[]              @relation("ReconApprovedBy")

  @@unique([companyId, id])
  @@unique([companyId, email])
  @@unique([companyId, username])
  @@index([companyId, status])
  @@map("users")
}

model AuthSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Configuration {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  configKey   String    @map("config_key")
  configValue String?   @map("config_value")
  valueType   ValueType @default(STRING) @map("value_type")
  description String?
  isSecret    Boolean   @default(false) @map("is_secret")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, configKey])
  @@map("configurations")
}

model Sequence {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  sequenceName String   @map("sequence_name")
  prefix       String
  currentValue BigInt   @default(0) @map("current_value")
  padding      Int      @default(4)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, sequenceName])
  @@map("sequences")
}

model Attachment {
  outputReconUploads OutputReconUpload[]
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  originalFilename String   @map("original_filename")
  storedFilename   String   @map("stored_filename")
  storageProvider  String   @map("storage_provider")
  storagePath      String   @map("storage_path")
  mimeType         String?  @map("mime_type")
  fileSize         BigInt?  @map("file_size")
  checksumSha256   String?  @map("checksum_sha256")
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  company               Company          @relation(fields: [companyId], references: [id])
  uploadedBy            User?            @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  documents             Document[]
  quotationPdfs         Quotation[]
  reconciliationSources Reconciliation[]

  @@index([companyId, checksumSha256])
  @@map("attachments")
}

model Document {
  invoicePayments InvoicePayment[]
  invoices Invoice[]
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  documentCode   String         @map("document_code")
  documentType   String         @map("document_type")
  entityType     String?        @map("entity_type")
  entityId       String?        @map("entity_id") @db.Uuid
  documentNumber String?        @map("document_number")
  versionNo      Int            @default(1) @map("version_no")
  documentDate   DateTime?      @map("document_date") @db.Date
  attachmentId   String         @map("attachment_id") @db.Uuid
  status         DocumentStatus @default(ACTIVE)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company                     Company                       @relation(fields: [companyId], references: [id])
  attachment                  Attachment                    @relation(fields: [attachmentId], references: [id])
  createdBy                   User?                         @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  activationConditionEvidence ContractActivationCondition[]
  officialForContracts        Contract[]                    @relation("ContractOfficialDocument")

  @@unique([companyId, documentCode])
  @@index([companyId, entityType, entityId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  traceId    String?  @map("trace_id")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Partner {
  invoices Invoice[]
  outputReconUploads OutputReconUpload[]
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  partnerCode         String        @map("partner_code")
  partnerKey          String        @default(uuid()) @map("partner_key")
  legalName           String        @map("legal_name")
  shortName           String?       @map("short_name")
  partnerType         PartnerType   @map("partner_type")
  status              PartnerStatus @default(ACTIVE)
  countryCode         String?       @map("country_code") @db.VarChar(2)
  countryName         String?       @map("country_name")
  partnerCategory     String?       @map("partner_category")
  invoiceRecipient    String?       @map("invoice_recipient")
  contactName         String?       @map("contact_name")
  createdBy           String?       @map("created_by")
  updatedBy           String?       @map("updated_by")
  invoiceEmail        String?       @map("invoice_email")
  billingAddress      String?       @map("billing_address")
  taxCode             String?       @map("tax_code")
  registrationNumber  String?       @map("registration_number")
  legalRepresentative String?       @map("legal_representative")
  registeredAddress   String?       @map("registered_address")
  phone               String?
  email               String?
  website             String?
  defaultCurrency     String?       @map("default_currency") @db.VarChar(3)
  paymentTermDays     Int?          @map("payment_term_days")
  ownerUserId         String?       @map("owner_user_id") @db.Uuid
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company         Company              @relation(fields: [companyId], references: [id])
  owner           User?                @relation("PartnerOwner", fields: [ownerUserId], references: [id])
  contacts        PartnerContact[]
  bankAccounts    PartnerBankAccount[]
  partnerServices PartnerService[]
  contracts       Contract[]
  contractParties ContractParty[]
  projects        Project[]
  quotations      Quotation[]
  reconciliations Reconciliation[]
  revenues        Revenue[]
  invoiceScopes   InvoiceScope[]

  @@unique([companyId, partnerCode])
  @@unique([companyId, partnerKey])
  @@index([companyId, legalName])
  @@index([companyId, taxCode])
  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@map("partners")
}

model PartnerContact {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  partnerId  String       @map("partner_id") @db.Uuid
  fullName   String       @map("full_name")
  jobTitle   String?      @map("job_title")
  department String?
  email      String?
  phone      String?
  whatsapp   String?
  role       ContactRole  @default(OTHER)
  isPrimary  Boolean      @default(false) @map("is_primary")
