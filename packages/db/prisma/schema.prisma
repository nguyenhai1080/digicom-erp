  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(20,4)
  issuedAt DateTime? @map("issued_at")
  issuedById String? @map("issued_by_id") @db.Uuid
  snapshot Json
  documentId String @map("document_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company Company @relation(fields: [companyId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  document Document @relation(fields: [documentId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])
  scopes InvoiceScope[]
  receivable AccountReceivable?
  payments InvoicePayment[]
  @@unique([companyId,id])
  @@unique([companyId,invoiceNumber])
  @@unique([companyId,businessKey,revisionNo])
  @@index([companyId,partnerId,period])
  @@map("invoices")
}

// One AR is created atomically on explicit Invoice issue, never on draft creation.
model AccountReceivable {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  originalAmount Decimal @map("original_amount") @db.Decimal(20,4)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(20,4)
  outstandingAmount Decimal @map("outstanding_amount") @db.Decimal(20,4)
  status String @default("OPEN") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  invoice Invoice @relation(fields:[companyId,invoiceId],references:[companyId,id])
  @@unique([companyId,invoiceId])
  @@index([companyId,status])
  @@map("account_receivables")
}

model InvoiceScopeItem {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  scopeId   String   @map("scope_id") @db.Uuid
  revenueId String   @map("revenue_id") @db.Uuid
  lineNo    Int      @map("line_no")
  amount    Decimal  @db.Decimal(20, 4)
  isCurrent Boolean  @default(true) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  company Company      @relation(fields: [companyId], references: [id])
  scope   InvoiceScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  revenue Revenue      @relation(fields: [revenueId], references: [id])

  @@unique([scopeId, revenueId])
  @@unique([scopeId, lineNo])
  @@index([companyId, revenueId])
  @@map("invoice_scope_items")
}

// Each immutable approved receipt is both a USD invoice allocation and a VND cash movement.
model InvoicePayment {
  cashAccountId String? @map("cash_account_id") @db.Uuid
  cashAccount CashAccount? @relation(fields:[companyId,cashAccountId],references:[companyId,id],onDelete:Restrict)
  allocationCurrency String @default("USD") @map("allocation_currency") @db.VarChar(3)
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  paymentCode String @map("payment_code")
  requestId String @map("request_id") @db.Uuid
  requestDigest String @map("request_digest")
  paymentDate DateTime @map("payment_date") @db.Date
  paidUsd Decimal @map("paid_usd") @db.Decimal(20,2)
  paidVnd Decimal? @map("paid_vnd") @db.Decimal(20,0)
  fxRate Decimal? @map("fx_rate") @db.Decimal(20,4)
  allocationAmount Decimal @map("allocation_amount") @db.Decimal(20,2)
  cashCurrency String @default("VND") @map("cash_currency") @db.VarChar(3)
  cashAmount Decimal @map("cash_amount") @db.Decimal(20,2)
  historicalSource Json? @map("historical_source")
  swiftNo String @map("swift_no")
  bankAccount String @map("bank_account")
  paymentMethod String @map("payment_method")
  note String
  documentId String? @map("document_id") @db.Uuid
  approvedById String @map("approved_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  invoice Invoice @relation(fields:[companyId,invoiceId],references:[companyId,id])
  document Document? @relation(fields:[documentId],references:[id],onDelete:Restrict)
  approvedBy User @relation("PaymentApprovedBy",fields:[approvedById],references:[id])
  @@unique([companyId,requestId])
  @@unique([companyId,paymentCode])
  @@index([companyId,invoiceId,paymentDate])
  @@map("invoice_payments")
}

// Company-owned bank accounts and cash funds. Historical receipts have no account link.
model CashAccount {
 transfersOut CashTransfer[] @relation("CashTransferSource")
 transfersIn CashTransfer[] @relation("CashTransferDestination")
 expenses Expense[]
 id String @id @default(uuid()) @db.Uuid
 companyId String @map("company_id") @db.Uuid
 accountCode String @map("account_code")
 name String
 kind String @db.VarChar(10)
 currency String @db.VarChar(3)
 bankName String @map("bank_name")
 accountNumber String @map("account_number")
 holderName String @map("holder_name")
 openingDate DateTime @map("opening_date") @db.Date
 openingBalance Decimal @map("opening_balance") @db.Decimal(20,2)
 balance Decimal @db.Decimal(20,2)
 status String @default("ACTIVE") @db.VarChar(10)
 note String
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 entries CashEntry[]
 invoicePayments InvoicePayment[]
 @@unique([companyId,id])
 @@unique([companyId,accountCode])
 @@index([companyId,status,currency])
 @@map("cash_accounts")
}
model Expense {
 direction String @default("OUT") @db.VarChar(3)
 purpose String @default("Khác")
 projectLabel String @default("") @map("project_label")
 nature String @default("ACTUAL") @db.VarChar(20)
 id String @id @default(uuid()) @db.Uuid
 companyId String @map("company_id") @db.Uuid
 cashAccountId String @map("cash_account_id") @db.Uuid
 expenseCode String @map("expense_code")
 requestId String @map("request_id") @db.Uuid
 requestDigest String @map("request_digest")
 expenseDate DateTime @map("expense_date") @db.Date
 category String @db.VarChar(30)
 description String
 payee String
 reference String
 currency String @db.VarChar(3)
 amount Decimal @db.Decimal(20,2)
 status String @default("DRAFT") @db.VarChar(10)
 note String
 documentId String? @map("document_id") @db.Uuid
 createdById String @map("created_by_id") @db.Uuid
 postedById String? @map("posted_by_id") @db.Uuid
 postedAt DateTime? @map("posted_at")
 voidReason String? @map("void_reason")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 account CashAccount @relation(fields:[companyId,cashAccountId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,expenseCode])
 @@unique([companyId,requestId])
 @@index([companyId,expenseDate,status])
 @@map("expenses")
}
model CashHistory {
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict,map:"cash_history_company_fkey")
 id String @id @default(uuid()) @db.Uuid
 companyId String @map("company_id") @db.Uuid
 sourceKey String @map("source_key")
 sourceDigest String @map("source_digest")
 sourceFile String @map("source_file")
 sourceReferences Json @map("source_references")
 sourceData Json @map("source_data")
 transactionDate DateTime @map("transaction_date") @db.Date
 direction String @db.VarChar(3)
 kind String @db.VarChar(20)
 amount Decimal @db.Decimal(20,2)
 currency String @default("VND") @db.VarChar(3)
 sender String
 recipient String
 description String
 purpose String
 projectLabel String @map("project_label")
 nature String @db.VarChar(20)
 importedById String @map("imported_by_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([companyId,sourceKey])
 @@index([companyId,transactionDate,kind])
 @@map("cash_history")
}
model CashEntry {
 id String @id @default(uuid()) @db.Uuid
 companyId String @map("company_id") @db.Uuid
 cashAccountId String @map("cash_account_id") @db.Uuid
 entryCode String @map("entry_code")
 entryDate DateTime @map("entry_date") @db.Date
 kind String @db.VarChar(30)
 direction String @db.VarChar(3)
 currency String @db.VarChar(3)
 amount Decimal @db.Decimal(20,2)
 balanceAfter Decimal @map("balance_after") @db.Decimal(20,2)
 sourceId String @map("source_id") @db.Uuid
 description String
 createdAt DateTime @default(now()) @map("created_at")
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 account CashAccount @relation(fields:[companyId,cashAccountId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,entryCode])
 @@unique([companyId,kind,sourceId])
 @@index([companyId,cashAccountId,entryDate,id])
 @@map("cash_entries")
}

model CashTransfer {
 id String @id @default(uuid()) @db.Uuid
 companyId String @map("company_id") @db.Uuid
 transferCode String @map("transfer_code")
 requestId String @map("request_id") @db.Uuid
 requestDigest String @map("request_digest")
 sourceAccountId String @map("source_account_id") @db.Uuid
 destinationAccountId String @map("destination_account_id") @db.Uuid
 transferDate DateTime @map("transfer_date") @db.Date
 currency String @db.VarChar(3)
 amount Decimal @db.Decimal(20,2)
 description String
 reference String
 note String
 status String @default("POSTED") @db.VarChar(10)
 documentId String? @map("document_id") @db.Uuid
 createdById String @map("created_by_id") @db.Uuid
 voidReason String? @map("void_reason")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 source CashAccount @relation("CashTransferSource",fields:[companyId,sourceAccountId],references:[companyId,id],onDelete:Restrict)
 destination CashAccount @relation("CashTransferDestination",fields:[companyId,destinationAccountId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,requestId])
 @@unique([companyId,transferCode])
 @@index([companyId,transferDate,id])
 @@map("cash_transfers")
}
