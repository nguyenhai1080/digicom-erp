NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://dgc_dev:dgc_local_only@localhost:55432/dgc_finance_dev?schema=public
SESSION_SECRET=replace-with-a-long-random-secret
DEFAULT_COMPANY_CODE=DGC
# Supply the confirmed legal name before the one-time seed.
DEFAULT_COMPANY_NAME=
DEFAULT_COMPANY_CURRENCY=USD
DEFAULT_COMPANY_TIMEZONE=Africa/Maputo
APP_NAME=DGC Finance
APP_TITLE=DGC Finance
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
LOG_LEVEL=info
AUTH_BOOTSTRAP_ENABLED=false
# Set a private one-time token only while provisioning the first administrator.
AUTH_BOOTSTRAP_TOKEN=disabled
ERP_SEED_ON_START=false
# Optional read-only migration evidence reader; leave both blank until mounted locally.
# Does not enable financial import, approval, Invoice or cash posting.
DGC_MIGRATION_EVIDENCE_COMPANY_ID=
DGC_MIGRATION_EVIDENCE_SNAPSHOT_HASH=
