{
  "name": "erp-core-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "migration:prepare": "node scripts/dgc-migration.mjs prepare",
    "migration:review-references": "node scripts/dgc-migration.mjs review-references",
    "migration:review-finance": "node scripts/dgc-migration.mjs review-finance",
    "migration:prepare-invoice-history": "node scripts/dgc-migration.mjs prepare-invoice-history",
    "migration:verify-invoice-history": "node scripts/dgc-migration.mjs verify-invoice-history",
    "migration:verify-invoice-files": "node scripts/dgc-migration.mjs verify-invoice-files",
    "migration:create-invoice-archive": "node scripts/dgc-migration.mjs create-invoice-archive",
    "migration:verify-invoice-archive": "node scripts/dgc-migration.mjs verify-invoice-archive",
    "migration:list-invoice-archive": "node scripts/dgc-migration.mjs list-invoice-archive",
    "test:migration": "node scripts/dgc-migration/core.test.mjs && node scripts/dgc-migration/graph.test.mjs && node scripts/dgc-migration/finance-review.test.mjs && node scripts/dgc-migration/invoice-history.test.mjs && node scripts/dgc-migration/invoice-files.test.mjs && node scripts/dgc-migration/invoice-archive.test.mjs",
    "test:migration:staging": "node scripts/dgc-migration/staging.integration.mjs",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @erp/db db:generate",
    "db:migrate": "pnpm --filter @erp/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @erp/db db:migrate:deploy",
    "db:seed": "pnpm --filter @erp/db db:seed"
  }
}
