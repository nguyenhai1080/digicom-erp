{
  "name": "dgc-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "prisma generate --schema database/prisma/schema.prisma && tsc -p database/tsconfig.json && tsc -p tsconfig.json",
    "start": "npm run db:migrate:deploy && node start.mjs",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@erp/db": "file:./database",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "adm-zip": "0.5.16",
    "fastify": "5.12.5",
    "pdf-lib": "1.17.1",
    "pino": "9.14.0",
    "sharp": "0.34.5",
    "zod": "4.6.5",
    "@types/adm-zip": "0.5.7",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}
