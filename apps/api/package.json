{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=../../.env dist/server.js",
    "test:assets": "node tests/company-assets.integration.mjs",
    "test:auth": "node tests/auth.integration.mjs",
    "test:execution": "node tests/execution.integration.mjs",
    "test:evidence": "node tests/evidence.integration.mjs",
    "test:partners": "node tests/partners.integration.mjs",
    "test:services": "node tests/services.integration.mjs",
    "test:service-contracts": "node tests/service-contracts.integration.mjs",
    "test:recon-financial": "node tests/recon-financial.characterization.mjs",
    "test:company-branding": "node tests/company-branding.mjs",
    "test:dgc-config": "node tests/dgc-config-preflight.mjs",
    "test:dgc-invoice": "node tests/dgc-invoice.characterization.mjs",
    "test:dgc-invoice:integration": "node tests/dgc-invoice.integration.mjs",
    "test:recon-invoice": "node tests/recon-invoice.integration.mjs",
    "test:dgc-recon": "node tests/dgc-recon.integration.mjs",
    "test:dgc-roles": "node tests/dgc-role-access.integration.mjs",
    "test:input-recon": "node tests/input-recon.characterization.mjs && node tests/input-recon-pdf.characterization.mjs && node tests/input-recon.integration.mjs"
  },
  "dependencies": {
    "@erp/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "adm-zip": "0.5.16",
    "fastify": "^5.6.1",
    "pdf-lib": "1.17.1",
    "pino": "^9.9.4",
    "sharp": "0.34.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "^24.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
